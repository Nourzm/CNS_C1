# Build stage
FROM python:3.11-slim as builder

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libopencv-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install
COPY backend/requirements.txt .
RUN pip install --user --no-cache-dir -r requirements.txt

# Copy application code into builder so warmup can run here during build
COPY backend/ /app/backend/
COPY ai/ /app/ai/
COPY config/ /app/config/

# Clean any corrupted model cache before warmup
RUN rm -rf /root/.insightface /root/.cache/pip

# Run one-time warmup in builder to pre-download the InsightFace model
# This saves the model under /root/.insightface and we'll copy it into the
# final runtime image below.
RUN python /app/backend/scripts/warmup.py || true

# Runtime stage
FROM python:3.11-slim

WORKDIR /app

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Copy python packages from builder
COPY --from=builder /root/.local /root/.local

# Copy pre-downloaded InsightFace model from builder (if present)
COPY --from=builder /root/.insightface /root/.insightface

# Copy application code
COPY backend/ /app/backend/
COPY ai/ /app/ai/
COPY config/ /app/config/

# Set environment variables
ENV PATH=/root/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PORT=8000

EXPOSE 8000

# Change to backend directory and run FastAPI
WORKDIR /app/backend
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
